<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DisfigureModManager</AssemblyName>
    <RootNamespace>DisfigureModManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../DisfigureSavePreset/SavePreset.cs" Link="SavePreset.cs" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="plugins.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
